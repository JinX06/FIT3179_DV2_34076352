{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "background": null,
  "padding": 5,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "url": "data/latest_crops.csv",
    "format": {
      "type": "csv",
      "parse": {
        "tonnes": "number",
        "value_aud_m": "number",
        "value_per_tonne": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "tonnes",
      "type": "quantitative",
      "title": "Production tonnes",
      "scale": {
        "domain": [
          0,
          1600000
        ]
      },
      "axis": {
        "format": ".2s",
        "tickCount": 4
      }
    },
    "y": {
      "field": "value_aud_m",
      "type": "quantitative",
      "title": "Farm gate value (A$ million)",
      "scale": {
        "domain": [
          0,
          1400
        ]
      },
      "axis": {
        "format": ",.0f",
        "tickCount": 5
      }
    },
    "tooltip": [
      {
        "field": "crop",
        "title": "Crop",
        "type": "nominal"
      },
      {
        "field": "financial_year_display",
        "title": "Year",
        "type": "nominal"
      },
      {
        "field": "tonnes_display",
        "title": "Production",
        "type": "nominal"
      },
      {
        "field": "value_aud_m_display",
        "title": "Farm gate value",
        "type": "nominal"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70,
        "opacity": 0.8,
        "color": "#416f86"
      }
    },
    {
      "transform": [
        {
          "filter": "datum.crop == 'Potatoes' || datum.crop == 'Tomatoes'"
        }
      ],
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.crop == 'Tomatoes' ? 'left' : 'right'"
        },
        "dx": {
          "expr": "datum.crop == 'Tomatoes' ? 8 : -6"
        },
        "dy": -12,
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "field": "crop"
        },
        "color": {
          "value": "#183247"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.crop == 'Mushrooms'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -12,
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "field": "crop"
        },
        "color": {
          "value": "#183247"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.crop == 'Leafy salad vegetables'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -20,
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "field": "crop"
        },
        "color": {
          "value": "#183247"
        }
      }
    }
  ],
  "transform": [
    {
      "calculate": "slice(datum.financial_year, 0, 4) + '-' + slice(datum.financial_year, 5)",
      "as": "financial_year_display"
    },
    {
      "calculate": "format(datum.tonnes, ',.0f') + ' t'",
      "as": "tonnes_display"
    },
    {
      "calculate": "'A$' + format(datum.value_aud_m, ',.1f') + 'm'",
      "as": "value_aud_m_display"
    }
  ],
  "config": {
    "font": "\"Source Sans 3\", Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#526575",
      "labelFontWeight": 400,
      "titleFontWeight": 400,
      "titleColor": "#526575",
      "domain": false,
      "tickColor": "#ced9df",
      "gridColor": "#D5DED3",
      "gridOpacity": 1,
      "labelPadding": 6,
      "titlePadding": 12,
      "labelExpr": "datum.value === 0 ? '0' : datum.label"
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#526575",
      "titleColor": "#526575",
      "labelFontWeight": 400,
      "titleFontWeight": 400,
      "padding": 5
    },
    "text": {
      "fontSize": 13,
      "fontWeight": 400,
      "color": "#183247"
    }
  }
}
